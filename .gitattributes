# Нормализация переносов строк: в репозитории LF, в рабочем каталоге CRLF.
# Правила перекрывают core.autocrlf конкретной машины — поведение одинаково у всех.
* text=auto eol=crlf

*.cs      text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.ps1     text eol=crlf
*.json    text eol=crlf
*.config  text eol=crlf
*.md      text eol=crlf
*.pgn     text eol=crlf
*.txt     text eol=crlf

*.png binary
*.exe binary
*.dll binary
